# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# Database: leave DB_ENGINE=sqlite for zero-setup local dev.
# Switch to postgres once you want to match the recommended production stack.
DB_ENGINE=sqlite
# --- only needed if DB_ENGINE=postgres ---
DB_NAME=lifeline
DB_USER=lifeline_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Week 3-4: Redis (Channels chat + Celery background jobs).
# Default assumes `docker run -d -p 6379:6379 redis` — see WEEK_2_3_4_GUIDE.md
REDIS_URL=redis://127.0.0.1:6379
